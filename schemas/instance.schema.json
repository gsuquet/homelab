{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gsuquet/homelab/schemas/instance.schema.json",
  "title": "Instance",
  "description": "Definition of one instance in instances/<name>/instance.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "description",
    "purpose",
    "lifecycle",
    "state",
    "layers"
  ],
  "properties": {
    "apiVersion": {
      "description": "Version of this schema.",
      "const": "infra.gsuquet.com/v1alpha1"
    },
    "kind": {
      "const": "Instance"
    },
    "name": {
      "description": "Instance name. Must be equal to the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "description": {
      "description": "One sentence that tells what the instance is for.",
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "purpose": {
      "description": "Why the instance exists. Production instances get the strictest rules.",
      "enum": [
        "production",
        "test",
        "demo"
      ]
    },
    "lifecycle": {
      "description": "How long the instance lives. An ephemeral instance must have a ttl.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "long-lived",
            "ephemeral"
          ]
        },
        "ttl": {
          "description": "Time before automatic destroy, in hours (h) or days (d).",
          "type": "string",
          "pattern": "^[1-9][0-9]*[hd]$"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "ephemeral"
          }
        }
      },
      "then": {
        "required": [
          "ttl"
        ]
      },
      "else": {
        "not": {
          "required": [
            "ttl"
          ]
        }
      }
    },
    "state": {
      "description": "Where the IaC state is stored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "enum": [
            "r2",
            "hcp-terraform",
            "local"
          ]
        }
      }
    },
    "layers": {
      "description": "The modules used for each layer, in the order of installation. Each module name must start with its layer name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "bootstrap"
      ],
      "properties": {
        "substrate": {
          "$ref": "#/$defs/layerRef",
          "properties": {
            "modules": {
              "items": {
                "pattern": "^substrate-"
              }
            }
          }
        },
        "cluster": {
          "$ref": "#/$defs/layerRef",
          "properties": {
            "modules": {
              "items": {
                "pattern": "^cluster-"
              }
            }
          }
        },
        "bootstrap": {
          "$ref": "#/$defs/layerRef",
          "properties": {
            "modules": {
              "items": {
                "pattern": "^bootstrap-"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Only a test instance can use local state. Production and demo instances use remote state.",
      "if": {
        "properties": {
          "purpose": {
            "enum": [
              "production",
              "demo"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "not": {
                  "const": "local"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "A production instance must be long-lived.",
      "if": {
        "properties": {
          "purpose": {
            "const": "production"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "type": {
                "const": "long-lived"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "layerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "description": "Names of folders in modules/, in the order of installation.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
